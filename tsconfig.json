{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": [
      "bun"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
